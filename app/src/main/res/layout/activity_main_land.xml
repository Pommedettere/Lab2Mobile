<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Изображение слева -->
    <ImageView
        android:id="@+id/artwork_image"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="centerCrop"
        android:contentDescription="@string/artwork_image_description"
        android:layout_marginEnd="16dp" />

    <!-- Правая часть -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Информация -->
        <TextView
            android:id="@+id/artwork_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artwork_title_1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/artwork_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artwork_author_1"
            android:textSize="20sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/artwork_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artwork_year_1"
            android:textSize="18sp"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/previous_button"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/previous"
                android:textSize="22sp"
                android:minHeight="100dp"
                android:contentDescription="@string/previous_button_description" />

            <Button
                android:id="@+id/next_button"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/next"
                android:textSize="22sp"
                android:minHeight="100dp"
                android:contentDescription="@string/next_button_description" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>